# Front-end build settings (Vite). Copy to .env.local for local overrides; nothing here is secret.
VITE_API_BASE_URL=https://bird-brain.duckdns.org
# '/' for Vercel (default); the GitHub Pages workflow sets /sabihs-birdbrain/
VITE_BASE_PATH=/
# Where the BirdNET weights (~78 MiB, 23 files) are fetched from at run time.
# Unset: a dev or preview server serves the repository's models/ folder itself, and a
# production build uses https://bird-brain.duckdns.org/models/birdnet-v2.4/.
# Set it to move the model to another host; the host must send CORS for this origin,
# and the host must also be listed in the connect-src of vercel.json.
# VITE_MODEL_BASE_URL=https://bird-brain.duckdns.org/models/birdnet-v2.4/
