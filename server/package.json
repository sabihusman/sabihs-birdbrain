{
  "name": "birdbrain-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sabih's Birdbrain API: accounts, email-code login, member-only AI questions",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@hono/node-server": "2.1.5",
    "better-auth": "1.7.11",
    "hono": "4.13.13",
    "nodemailer": "10.1.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
