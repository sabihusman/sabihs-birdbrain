# /etc/systemd/system/lego-renew-birdbrain.service
# Copy of lego-renew-sentinel.service with only the domain and the EnvironmentFile changed.
# All lego settings come from the EnvironmentFile, which setup.sh step 4 copies from
# /etc/lego/lego-sentinel.env changing only LEGO_DOMAINS. lego 5.x "run" skips renewal when
# the certificate is not yet due, so a daily run is safe.
[Unit]
Description=Renew Let's Encrypt certificate for bird-brain.duckdns.org via lego
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lego/lego-birdbrain.env
ExecStart=/usr/local/bin/lego run
ExecStartPost=/bin/systemctl reload nginx
