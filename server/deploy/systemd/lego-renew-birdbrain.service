# /etc/systemd/system/lego-renew-birdbrain.service
# Copy of lego-renew-sentinel.service with only the domain changed. setup.sh fills
# __LEGO_BIN__, __LEGO_PATH__ and __ACME_EMAIL__ from setup.conf (taken from Sentinel's unit).
[Unit]
Description=Renew Let's Encrypt certificate for bird-brain.duckdns.org (lego)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=__LEGO_BIN__ --accept-tos --email __ACME_EMAIL__ --path __LEGO_PATH__ --http --http.webroot /var/www/acme --domains bird-brain.duckdns.org renew --days 30 --renew-hook "/usr/sbin/nginx -t && /bin/systemctl reload nginx"
