# /etc/systemd/system/lego-renew-birdbrain.service
# Same pattern as lego-renew-sentinel.service: all lego settings come from an
# EnvironmentFile copied from /etc/lego/lego-sentinel.env with only LEGO_DOMAINS changed.
[Unit]
Description=Renew Let's Encrypt certificate for bird-brain.duckdns.org (lego)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lego/lego-birdbrain.env
ExecStart=/usr/local/bin/lego run
ExecStartPost=/bin/sh -c '/usr/sbin/nginx -t && /bin/systemctl reload nginx'
