# /etc/systemd/system/lego-renew-birdbrain.timer
# Copy of lego-renew-sentinel.timer with only the domain changed.
[Unit]
Description=Daily renewal check for bird-brain.duckdns.org certificate

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
