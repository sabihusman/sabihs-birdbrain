# /etc/nginx/sites-available/birdbrain  -- STAGE 2 (final)
# birdbrain-stage: full
# Birdbrain API only. Never merge with the mba-vault or sentinel files.
# Never claims default_server: the catch-all in sites-available/mba-vault owns it.
# Zones must be declared at http level; sites-enabled files are included inside http {}.
# The API. 6r/m with a burst of 5 was too tight for the app itself: signing in, opening the
# Species tab and saving a sighting each fire several calls within a second, and the refill of
# one request per ten seconds never caught up, so real calls were refused with 429 (seen on
# 2026-10-21: friends/species, auth/refresh and the shared-species upload). Those failures are
# silent by design, which made "Spotted by friends" look broken.
#
# 1 r/s with a burst of 20 covers every burst the app makes (the busiest second observed was 4
# requests, and the whole service sees about 130 calls a day), and still caps a flood. The real
# protection for sign-in lives in the API itself and is unchanged: 20 auth attempts per IP per
# 10 minutes, 6 per email address, and 5 tries on a 6-digit code before it is burned.
limit_req_zone  $binary_remote_addr zone=birdbrain:10m      rate=60r/m;
limit_conn_zone $binary_remote_addr zone=birdbrain_conn:10m;

# The BirdNET model files (/models/, see below) are static and downloaded in a burst of
# 23 requests per phone, so they get their own, much more lenient limits.
#
# 240r/m (4 r/s) was too tight: one cold start fits in the burst, but a reload or a second
# phone behind the same carrier NAT drains it, and nginx then answered 429 for the later
# shards, which TF.js reported as a corrupt tensor (seen live on 2026-10-20). 10 r/s with a
# burst of 60 covers a cold start plus a retry, and several phones on one address.
limit_req_zone  $binary_remote_addr zone=birdbrain_models:10m rate=600r/m;
limit_conn_zone $binary_remote_addr zone=birdbrain_models_conn:10m;

# CORS for the model files only, and only for this app's own origins: the production
# site and its Vercel preview deployments (sabihs-birdbrain-<something>.vercel.app).
# Any other Origin maps to "", and nginx then omits the header, so the browser blocks
# the response. Local development points VITE_MODEL_BASE_URL at its own file server.
map $http_origin $birdbrain_model_origin {
    default                                                       "";
    "https://sabihs-birdbrain.vercel.app"                         $http_origin;
    "~^https://sabihs-birdbrain-[a-z0-9-]+\.vercel\.app$"         $http_origin;
}

server {
    listen 80;
    listen [::]:80;
    server_name bird-brain.duckdns.org;

    # ACME HTTP-01 challenges: same webroot and same block as Sentinel (/var/www/acme).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # No http2 flag: on nginx 1.24 HTTP/2 is per address:port and the mba-vault catch-all already
    # enables it on the shared :443 socket; repeating it here only makes nginx -t warn.
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bird-brain.duckdns.org;

    # Paths are substituted by setup.sh from setup.conf (LEGO_PATH), matching Sentinel's layout.
    ssl_certificate     __LEGO_PATH__/certificates/bird-brain.duckdns.org.crt;
    ssl_certificate_key __LEGO_PATH__/certificates/bird-brain.duckdns.org.key;
    # Same as Sentinel. Without these the http-level default (TLSv1 TLSv1.1 ...) would apply.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Abuse limits (the app has its own on top).
    limit_req zone=birdbrain burst=20 nodelay;
    limit_req_status 429;
    # HTTP/2 counts every stream, and a phone opens several calls at once.
    limit_conn birdbrain_conn 10;
    limit_conn_status 429;
    client_max_body_size 16k;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # No CORS headers here: the app sets them for the exact allowed origin.

    # The BirdNET V2.4 export (~78 MiB, 23 files), published by
    # scripts/server/publish-model.sh into /opt/birdbrain/models/<version>/ and served
    # here instead of from Vercel (DECISIONS.md #56). Read-only static files; the API
    # container is not involved.
    location ^~ /models/ {
        # root, not alias: /models/<file> maps to /opt/birdbrain/models/<file> directly,
        # which keeps try_files simple (alias + try_files resolves the prefix twice).
        root /opt/birdbrain;
        try_files $uri =404;
        autoindex off;

        # Replaces the inherited API limits: a cold start fetches every shard at once.
        limit_req zone=birdbrain_models burst=60 nodelay;
        # nginx counts every HTTP/2 stream against limit_conn, and TF.js asks for all 13
        # weight shards at once on one connection, so a limit of 8 refused shards 9 to 13
        # with 429 and the model arrived truncated ("the tensor should have 6678528 values
        # but has 4020245", live on 2026-10-20). 32 leaves room for a cold start plus a
        # reload or a second phone, and still caps a client that opens hundreds.
        limit_conn birdbrain_models_conn 32;

        limit_except GET HEAD OPTIONS {
            deny all;
        }

        # A location-level add_header drops the server-level ones, so repeat them here.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        # Version folders never change in place: publish a new folder instead.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # Empty value = header omitted, which is what we want for every other origin.
        add_header Access-Control-Allow-Origin $birdbrain_model_origin always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Max-Age 86400 always;
        add_header Vary Origin always;

        # model.json is topology JSON; the .bin shards are already-packed float32 weights
        # (application/octet-stream), which gzip would only slow down.
        gzip on;
        gzip_types application/json;
        gzip_proxied any;
        gzip_min_length 1024;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
