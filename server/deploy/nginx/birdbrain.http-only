# /etc/nginx/sites-available/birdbrain  -- STAGE 1 (port 80 only, until the certificate exists)
# birdbrain-stage: http-only
# Birdbrain API only. Never merge with the mba-vault or sentinel files.
# Never claims default_server: the catch-all in sites-available/mba-vault owns it.
server {
    listen 80;
    listen [::]:80;
    server_name bird-brain.duckdns.org;

    # ACME HTTP-01 challenges: same webroot and same block as Sentinel (/var/www/acme).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
