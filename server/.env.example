# Copy to /opt/birdbrain/.env on the server (owner root, mode 600). Values are never committed.
# Required
BETTER_AUTH_SECRET=            # >= 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_URL=https://bird-brain.duckdns.org
ALLOWED_ORIGINS=https://sabihs-birdbrain.vercel.app   # exact production origin only; preview *.vercel.app URLs are not allowed. http://localhost:5173 is added automatically when NODE_ENV != production
ADMIN_EMAIL=                   # the account that becomes admin and is auto-approved at signup; also receives certificate-renewal failure alerts
SMTP_USER=                     # dedicated Birdbrain Gmail address
SMTP_APP_PASSWORD=             # Gmail app password for that address
GEMINI_API_KEY=                # Google AI Studio key; the fallback provider for /v1/ask (DECISIONS.md #49)
OLLAMA_API_KEY=                # Ollama Cloud key from https://ollama.com/settings/keys; the primary provider. Without it the Ollama provider is skipped with one startup line; with no key at all /v1/ask answers 502
BIRDBRAIN_IMAGE_TAG=sha-1cc01d4   # image tag compose.yml runs; change to promote a build (or latest)
# Optional (defaults shown)
# EBIRD_API_KEY=               # eBird API 2.0 key (ebird.org/api/keygen); without it "Ask about this bird" answers without eBird sightings. NatureServe needs no key.
# MAIL_FROM=Sabih's Birdbrain <SMTP_USER>
# MAIL_TRANSPORT=smtp          # or console (development only)
# GEMINI_MONTHLY_CAP_USD=2.00   # hard monthly Gemini spend cap (UTC month); at the cap Gemini is skipped, Ollama answers alone; admin mailed at 50 % and 100 %
# GEMINI_PRICE_IN=              # optional USD per 1M input tokens for GEMINI_MODEL (unknown models otherwise cost the most expensive known price)
# GEMINI_PRICE_OUT=             # optional USD per 1M output tokens
# GEMINI_MODEL=gemini-3.8-flash          # Google's deprecations page limits 2.5 models to existing users and recommends 3.8 Flash
# AI_PROVIDER_ORDER=ollama,gemini        # providers for /v1/ask, tried in this order; each falls back to the next on a limit, queue, 5xx, timeout, empty or cut-off answer. Names: ollama, gemini, anthropic
# OLLAMA_MODEL=gemma4:31b                # Sabih's choice (DECISIONS.md #49); the name as `curl -s https://ollama.com/api/tags -H "Authorization: Bearer $OLLAMA_API_KEY"` lists it
# OLLAMA_TIMEOUT_MS=8000                 # abort the Ollama call after this and fall back; the free plan serves one request at a time
# ANTHROPIC_API_KEY=                     # Anthropic API key (console.anthropic.com); enables the "anthropic" provider in AI_PROVIDER_ORDER. Never logged
# ANTHROPIC_MODEL=                       # required with the key; the model ID exactly as Anthropic lists it (no default, DECISIONS.md #91)
# ANTHROPIC_TIMEOUT_MS=20000             # abort the Claude call after this and fall back; the SDK does not retry
# ASK_DAILY_PER_USER=20
# ASK_DAILY_GLOBAL=200
# ASK_MAX_QUESTION_CHARS=500
# SESSION_TTL_SECONDS=86400
# SESSION_UPDATE_AGE_SECONDS=3600
# LOGIN_CODE_TTL_SECONDS=600
# BACKUP_RETENTION_DAYS=14
# BACKUP_MAX_BYTES=5368709120   # hard cap on the backup folder (5 GiB); oldest backups go first
# Set by compose.yml, not by .env: NODE_ENV, HOST, PORT, DATABASE_PATH, LABELS_PATH, BACKUP_DIR
